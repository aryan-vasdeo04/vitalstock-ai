# Copy this file to .env.local for local development (never commit .env.local).
# On Vercel, set these same variables under Project Settings -> Environment Variables instead.

# The chatbot is OFF by default — the app deploys and runs fully for free without this.
# To turn the chatbot on later, set BOTH of these and redeploy:
NEXT_PUBLIC_CHAT_ENABLED=false
ANTHROPIC_API_KEY=your_api_key_here
